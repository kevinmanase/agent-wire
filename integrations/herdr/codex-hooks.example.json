{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact",
      "hooks": [{"type": "command", "command": "python3 \"/ABSOLUTE/CODEX_HOME/skills/herdr-labels/scripts/herdr_tab.py\" hook codex", "timeout": 15}]
    }],
    "UserPromptSubmit": [{
      "hooks": [{"type": "command", "command": "python3 \"/ABSOLUTE/CODEX_HOME/skills/herdr-labels/scripts/herdr_tab.py\" hook codex", "timeout": 15}]
    }],
    "PreToolUse": [{
      "matcher": ".*request_user_input(_async)?",
      "hooks": [{"type": "command", "command": "python3 \"/ABSOLUTE/CODEX_HOME/skills/herdr-labels/scripts/herdr_tab.py\" hook codex", "timeout": 15}]
    }],
    "PermissionRequest": [{
      "matcher": ".*",
      "hooks": [{"type": "command", "command": "python3 \"/ABSOLUTE/CODEX_HOME/skills/herdr-labels/scripts/herdr_tab.py\" hook codex", "timeout": 15}]
    }],
    "Stop": [{
      "hooks": [{"type": "command", "command": "python3 \"/ABSOLUTE/CODEX_HOME/skills/herdr-labels/scripts/herdr_tab.py\" hook codex", "timeout": 15}]
    }]
  }
}
