{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact|fork",
      "hooks": [{"type": "command", "command": "python3 \"/ABSOLUTE/HOME/.claude/skills/herdr-labels/scripts/herdr_tab.py\" hook claude", "timeout": 15}]
    }],
    "UserPromptSubmit": [{
      "hooks": [{"type": "command", "command": "python3 \"/ABSOLUTE/HOME/.claude/skills/herdr-labels/scripts/herdr_tab.py\" hook claude", "timeout": 15}]
    }],
    "PreToolUse": [{
      "matcher": "AskUserQuestion",
      "hooks": [{"type": "command", "command": "python3 \"/ABSOLUTE/HOME/.claude/skills/herdr-labels/scripts/herdr_tab.py\" hook claude", "timeout": 15}]
    }],
    "PermissionRequest": [{
      "matcher": ".*",
      "hooks": [{"type": "command", "command": "python3 \"/ABSOLUTE/HOME/.claude/skills/herdr-labels/scripts/herdr_tab.py\" hook claude", "timeout": 15}]
    }],
    "Stop": [{
      "hooks": [{"type": "command", "command": "python3 \"/ABSOLUTE/HOME/.claude/skills/herdr-labels/scripts/herdr_tab.py\" hook claude", "timeout": 15}]
    }]
  }
}
